# Embodied DataOps - local development environment.
# Copy to .env (make bootstrap does this). Never commit real secrets.
#
# API keys are NOT stored here. scripts/bootstrap.sh prints the initial keys
# exactly once and stores only their SHA-256 digest in PostgreSQL.

ENVIRONMENT=local
LOG_LEVEL=INFO

# --- PostgreSQL 16 (single source of truth for tasks & metadata) -------------
POSTGRES_USER=dataops
POSTGRES_PASSWORD=dataops
POSTGRES_DB=dataops
DATABASE_URL=postgresql+psycopg://dataops:dataops@localhost:5432/dataops

# --- Redis 7.4 Streams (wakeup hints only, never the task truth source) ------
REDIS_URL=redis://localhost:6379/0

# --- Object storage: S3-compatible service (PGSTY Silo / MinIO API) ---------
#     Upstream MinIO Docker Hub images are discontinued; compose uses pgsty/silo.
#     The bucket is created by the application (S3Storage.ensure_bucket).
STORAGE_BACKEND=s3
S3_BUCKET=dataops
S3_ENDPOINT_INTERNAL=http://minio:9000
# Presigned URLs handed to a *browser* are built from S3_ENDPOINT_PUBLIC.  The
# default below only works when the browser runs on this same machine.  On a cloud
# host set it to the public/隧道 address (or a reverse proxy in front of :9000):
#   S3_ENDPOINT_PUBLIC=https://objects.example.com
# Otherwise the UI shows working credentials pointing at an unreachable localhost.
S3_ENDPOINT_PUBLIC=http://localhost:9000
S3_ACCESS_KEY=dataops
S3_SECRET_KEY=dataops-secret
S3_REGION=us-east-1
# Set to ./var/objects to run without MinIO (unit tests / offline demo).
LOCAL_STORAGE_ROOT=./var/objects

# --- Published host ports ----------------------------------------------------
# docker-compose binds every published port to this address.  Keep 127.0.0.1 on a
# shared/cloud machine and put a reverse proxy in front; 0.0.0.0 exposes Postgres,
# Redis and the object store directly.
DATAOPS_BIND_ADDR=127.0.0.1

API_PUBLIC_BASE_URL=http://localhost:8000
# Host-side runs (make ui).  The compose `ui` service overrides this with
# http://api:8000 because inside a container "localhost" is the container.
UI_API_BASE_URL=http://localhost:8000

# --- Upload / import limits (spec 5.1, 12.1) --------------------------------
MAX_UPLOAD_BYTES=2147483648
MAX_UNPACKED_BYTES=4294967296
MAX_TAR_ENTRIES=10000
UPLOAD_URL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=600

# --- Task protocol (spec 6) --------------------------------------------------
LEASE_SECONDS=60
HEARTBEAT_SECONDS=15
REAPER_INTERVAL_SECONDS=10
DISPATCHER_INTERVAL_SECONDS=1
MAX_ATTEMPTS=3
WORKER_CPU_CONCURRENCY=2
WORKER_VISION_CONCURRENCY=1

# --- Pipeline / quality ------------------------------------------------------
PIPELINE_VERSION=1.0.0
QC_POLICY_VERSION=qc-policy/1.0

# --- Detection (spec 8) ------------------------------------------------------
# fake  -> deterministic FakeDetector, contract/scale tests only
# yolo11n -> real ultralytics YOLO11n inference
DETECTOR=fake
YOLO_WEIGHTS_PATH=./var/models/yolo11n.pt
YOLO_WEIGHTS_SHA256=
YOLO_CONF=0.35
YOLO_IOU=0.5
# The detector reads YOLO_DEVICE (config.py).  Use `cuda` only inside the GPU
# overlay (docker-compose.gpu.yml) with a CUDA torch build.
YOLO_DEVICE=cpu

# --- V2.1 AI pre-annotation (SPEC_V2.1 §5.4) --------------------------------
# disabled -> the AI branch refuses to start (no silent fake result)
# replay   -> offline provider, always labelled mode=REPLAY; never live evidence
# dashscope-> real remote Qwen2.5-VL through the OpenAI-compatible endpoint
VLM_PROVIDER=disabled
VLM_PROMPT_VERSION=ego-action-prompt/2.1
VLM_PROMPT_PATH=./contracts/EGO_ACTION_PROMPT_V21.md
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen2.5-vl-7b-instruct
# Only for VLM_PROVIDER=dashscope. Never commit a real key.
DASHSCOPE_API_KEY=
VLM_API_KEY=
VLM_MAX_IMAGES_PER_CLIP=8
VLM_MAX_SIDE_PX=768
VLM_JPEG_QUALITY=80
VLM_TIMEOUT_S=60
VLM_MAX_ATTEMPTS=3
VLM_CONCURRENCY=2
VLM_MAX_OUTPUT_TOKENS=512
VLM_BUDGET_USD_PER_RUN=2.0
# A model_inferences row left RUNNING longer than this is a reservation whose worker
# died; the reaper settles it so the budget is not held forever.  Keep it above the
# VLM_PREANNOTATE_CLIP wall clock (900 s).
VLM_STALE_INFERENCE_SECONDS=1800
# Price snapshot for the cost estimate (USD per 1M tokens).  Leave empty when the
# provider price is unknown: the report then says "cost unknown" instead of guessing.
VLM_PRICE_PER_MILLION_PROMPT_USD=
VLM_PRICE_PER_MILLION_COMPLETION_USD=
VLM_PRICE_SNAPSHOT_NOTE=
VLM_REPLAY_DIR=./var/vlm-replay

# --- Optional P1 providers (disabled by default) ----------------------------
SAM2_ENABLED=false

# --- Observability -----------------------------------------------------------
PROMETHEUS_ENABLED=true

# --- Build/network mirrors (optional; empty = official indexes) --------------
# Used by `docker compose build` for pip-installed uv and Python dependencies.
# Example for a restricted network:
#   PYPI_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
#   UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
PYPI_INDEX_URL=https://pypi.org/simple
UV_DEFAULT_INDEX=https://pypi.org/simple
